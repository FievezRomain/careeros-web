# Public browser configuration only. Never add a client secret.
VITE_OIDC_AUTHORITY=https://identity.example.invalid/realms/careeros
VITE_OIDC_CLIENT_ID=careeros-web
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/sign-in
VITE_PROFILE_API_BASE_URL=http://localhost:8002
